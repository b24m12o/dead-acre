{
  "name": "dead-acre",
  "private": true,
  "description": "Dead Acre, a night-by-night survival shooter.",
  "license": "UNLICENSED",
  "type": "module",
  "scripts": {
    "build": "node tools/build.mjs",
    "lint": "eslint .",
    "test": "node tests/run.mjs",
    "test:campaign": "node tests/run.mjs campaign",
    "format": "prettier --write \"src/**/*.js\" \"tools/**/*.mjs\" \"tests/**/*.mjs\" eslint.config.js",
    "verify": "prettier --check \"src/**/*.js\" \"tools/**/*.mjs\" \"tests/**/*.mjs\" eslint.config.js && eslint . && node tools/build.mjs && git diff --exit-code --stat -- dist index.html",
    "testrange": "node tools/testrange/build.mjs"
  },
  "devDependencies": {
    "@eslint/js": "^9.12.0",
    "csso": "5.0.5",
    "esbuild": "^0.24.0",
    "eslint": "^9.12.0",
    "globals": "^15.11.0",
    "playwright": "^1.56.0",
    "prettier": "^3.3.3",
    "terser": "5.31.0"
  }
}
